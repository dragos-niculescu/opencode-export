#!/usr/bin/env bash
# opencode-export — Export and share OpenCode sessions
#
# Session data comes from `opencode session export` when the CLI is available
# (the stable, documented format), and falls back to reading the local OpenCode
# SQLite database directly (schema v2 for OpenCode 2.x, v1 for older releases).
#
# Subcommands:
#   list                          List recent local sessions
#   show <session_id>             Print session as Markdown to stdout
#   html <session_id> [-o FILE]   Render with the same view as the web GUI
#   upload <session_id> [-p]      Upload session to share server, print URL
#                                 -p prompts for a password to protect the page
#   shares [-s <keyword>] [-n N]  List sessions already shared on the server
#   password <slug|url> [-p|--clear]
#                                 Set, change or remove a share's password
#   delete <slug|url>             Delete a shared session by slug or URL
#   purge                         Delete ALL shared sessions from the server
#
# Defaults:
#   With no arguments, runs `list`.
#   A bare session_id is treated as `show` (legacy convenience).
#
# Config file: ~/.config/opencode-export/config
#   SHARE_URL=https://share.example.com
#   SHARE_TOKEN=your-bearer-token
#
# Env:
#   OPENCODE_DB             override database path
#   OPENCODE_EXPORT_SOURCE  auto (default) | cli | db
#                           auto: try `opencode session export`, fall back to the DB
#                           cli:  only use the OpenCode CLI
#                           db:   only read the SQLite database
#
# Dependencies: sqlite3, jq, curl; the `opencode` CLI is used when present.

set -euo pipefail

print_help() {
    cat <<EOF
Usage:
  $(basename "$0") list [-s <keyword>] [-n <count>]
        List recent sessions (default 20). -s filters by title.

  $(basename "$0") show <session_id>
        Print full session as Markdown to stdout.

  $(basename "$0") html <session_id> [-o <file>]
        Render the session with the same PHP renderer and template as the web
        GUI. Writes HTML to stdout unless -o/--output is supplied.

  $(basename "$0") upload <session_id> [-p | --password-stdin | --clear-password]
        Upload session to share server (sends JSON, server renders HTML).
        Prints the share URL to stdout.
          -p, --password     prompt for a password; viewers must enter it
                             (raw JSON: curl -u :PASSWORD <url>/raw)
          --password-stdin   read the password from stdin (for scripts)
          --clear-password   remove password protection from an existing share
        Re-uploading without any password flag keeps the current protection.

  $(basename "$0") shares [-s <keyword>] [-n <count>]
        List sessions already shared on the server.
        -s filters by title, -n limits output (default: all).

  $(basename "$0") password <slug|url> [-p | --password-stdin | --clear]
        Set or change the password of an existing share (-p prompts, default),
        or remove it with --clear.

  $(basename "$0") delete <slug|url>
        Remove a shared session from the server.

  $(basename "$0") purge
        Delete ALL shared sessions from the server (asks for confirmation).

Env:
  OPENCODE_DB             override database path
  OPENCODE_EXPORT_SOURCE  auto (default) | cli | db
EOF
}

for arg in "$@"; do
    case "$arg" in
        -h|--help) print_help; exit 0 ;;
    esac
done

# ---------- database location ----------
# OpenCode stores its database under the XDG data dir on Linux and under
# Application Support on macOS. Pick the first existing candidate.
default_db() {
    local candidates=(
        "${XDG_DATA_HOME:-$HOME/.local/share}/opencode/opencode.db"
        "$HOME/Library/Application Support/opencode/opencode.db"
    )
    local c
    for c in "${candidates[@]}"; do
        if [[ -f "$c" ]]; then printf '%s' "$c"; return; fi
    done
    printf '%s' "${candidates[0]}"
}

DB="${OPENCODE_DB:-$(default_db)}"
CONFIG_FILE="$HOME/.config/opencode-export/config"

die() { echo "error: $*" >&2; exit 1; }

# Load config if present
if [[ -f "$CONFIG_FILE" ]]; then
    # The config holds the bearer token: warn if other users on this machine can read it.
    perms=$(stat -f '%Lp' "$CONFIG_FILE" 2>/dev/null || stat -c '%a' "$CONFIG_FILE" 2>/dev/null || echo "")
    if [[ -n "$perms" && "${perms: -2}" != "00" ]]; then
        echo "warning: $CONFIG_FILE is readable by other users — run: chmod 600 $CONFIG_FILE" >&2
    fi
    # shellcheck disable=SC1090
    set -a; source "$CONFIG_FILE"; set +a
fi

EXPORT_SOURCE="${OPENCODE_EXPORT_SOURCE:-auto}"

case "$EXPORT_SOURCE" in
    auto|cli|db) ;;
    *) die "OPENCODE_EXPORT_SOURCE must be one of: auto, cli, db" ;;
esac

command -v sqlite3 >/dev/null || die "sqlite3 is required"
command -v jq      >/dev/null || die "jq is required (brew install jq)"
command -v curl    >/dev/null || die "curl is required"

need_db() { [[ -f "$DB" ]] || die "database not found: $DB"; }

have_cli() { [[ "$EXPORT_SOURCE" != "db" ]] && command -v opencode >/dev/null 2>&1; }

need_session_source() {
    if have_cli; then return 0; fi
    [[ "$EXPORT_SOURCE" == "cli" ]] && die "opencode CLI not found in PATH"
    need_db
}

# Temp files are registered here and removed on exit, including on `die`.
_TMP=()
cleanup() { rm -rf ${_TMP[@]+"${_TMP[@]}"}; }
trap cleanup EXIT
tmp_dir()  { TMP_RESULT=$(mktemp -d); _TMP+=("$TMP_RESULT"); }
tmp_file() { TMP_RESULT=$(mktemp);    _TMP+=("$TMP_RESULT"); }

sq() { sqlite3 -readonly "$DB" "$@"; }

sql_escape() { printf '%s' "${1//\'/\'\'}"; }

is_uint() { [[ "$1" =~ ^[0-9]+$ ]]; }

# Which schema does this database use? v2 is OpenCode 2.x (session_v2 /
# session_message), v1 is the legacy layout (session / message / part).
DB_SCHEMA=""
db_schema() {
    if [[ -n "$DB_SCHEMA" ]]; then printf '%s' "$DB_SCHEMA"; return; fi
    [[ -f "$DB" ]] || { printf ''; return; }
    local t
    t=$(sq "SELECT name FROM sqlite_master WHERE type='table' AND name IN ('session_v2','session') ORDER BY (name='session_v2') DESC LIMIT 1;")
    case "$t" in
        session_v2) DB_SCHEMA=v2 ;;
        session)    DB_SCHEMA=v1 ;;
        *)          DB_SCHEMA=unknown ;;
    esac
    printf '%s' "$DB_SCHEMA"
}

need_server() {
    [[ -n "${SHARE_URL:-}"   ]] || die "SHARE_URL not configured (see ~/.config/opencode-export/config)"
    [[ -n "${SHARE_TOKEN:-}" ]] || die "SHARE_TOKEN not configured"
}

# curl wrapper: bearer auth, sane timeouts, prints HTTP status; body goes to $1.
# The Authorization header goes through a private temp file (curl -H @file) so
# the token never shows up in the process list.
api_call() {
    local out="$1"; shift
    tmp_file; local hdr="$TMP_RESULT"
    chmod 600 "$hdr"
    printf 'Authorization: Bearer %s\n' "$SHARE_TOKEN" > "$hdr"
    local code rc=0
    code=$(curl -sS --max-time 120 -H "@$hdr" -o "$out" -w '%{http_code}' "$@") || rc=$?
    rm -f "$hdr"
    [[ $rc -eq 0 ]] || return $rc
    printf '%s' "$code"
}

# ---------- canonical session JSON ----------
# Everything below (show, upload) consumes one normalised shape:
#
#   { session_id, title, created_at, updated_at, directory, agent, model,
#     tokens: {input, output, reasoning, cache_read, cache_write}, cost,
#     messages: [ {id, time_created, role, model, tokens, cost, finish,
#                  parts: [ {type: text|reasoning|tool|file|compaction, ...} ]} ] }
#
# Three sources feed it: `opencode session export`, the v2 database and the
# legacy v1 database. All three are first turned into an "export-like"
# document, so only this one jq program needs to know the canonical shape.

CANON_JQ=$(cat <<'JQ'
def norm_model:
  if type == "string" and startswith("{") then (fromjson? // .) else . end;

def part:
  if .type == "text" then {type:"text", text:(.text // "")}
  elif .type == "reasoning" then
    {type:"reasoning",
     text:(if (.text // "") != "" then .text
           else ((.state.thinking.thinking // []) | map(.text // "") | join("")) end)}
  elif .type == "tool" then
    {type:"tool",
     tool:(.name // .tool // "unknown"),
     state:{
       status:(.state.status // "unknown"),
       input:(.state.input // null),
       output:(if (.state.output // null) != null then .state.output
               elif (.state.content // null) != null then
                 (.state.content
                  | map(if type == "string" then .
                        elif (.type // "") == "text" then (.text // "")
                        else tojson end)
                  | join("\n\n"))
               else null end),
       error:(if (.state.error // null) == null then null
              elif (.state.error | type) == "string" then .state.error
              else (.state.error.message // (.state.error | tojson)) end)
     }}
  elif .type == "file" then
    {type:"file", filename:(.filename // .name // "(unnamed)"), mime:(.mime // ""),
     url:(.url // .source.uri // "")}
  elif .type == "compaction" then {type:"compaction", auto:(.auto // false)}
  elif .type == "step-start" or .type == "step-finish" then empty
  else . end;

def file_part:
  {type:"file", filename:(.name // .filename // "(unnamed)"), mime:(.mime // ""),
   url:(.url // .source.uri // "")};

def message:
  . as $m
  | {
      id: $m.id,
      time_created: (($m.time.created) // $m.time_created // null),
      role: (if $m.type == "user" then "user"
             elif $m.type == "assistant" then "assistant"
             else "system" end),
      model: (($m.model // null) | norm_model),
      tokens: ($m.tokens // null),
      cost: ($m.cost // null),
      finish: ($m.finish // null),
      parts: (
        if $m.type == "user" then
          (if ($m.text // "") != "" then [{type:"text", text:$m.text}] else [] end)
          + (($m.files // []) | map(file_part))
        elif $m.type == "assistant" then
          (($m.content // []) | map(part))
        else
          (if ($m.text // "") != "" then [{type:"text", text:$m.text}] else [] end)
        end
      )
    };

{
  session_id: .info.id,
  title: (.info.title // "(untitled)"),
  created_at: (.info.time.created // null),
  updated_at: (.info.time.updated // null),
  directory: (.info.location.directory // null),
  agent: (.info.agent // null),
  model: ((.info.model // null) | norm_model),
  tokens: {
    input:       (.info.tokens.input // 0),
    output:      (.info.tokens.output // 0),
    reasoning:   (.info.tokens.reasoning // 0),
    cache_read:  (.info.tokens.cache.read // 0),
    cache_write: (.info.tokens.cache.write // 0)
  },
  cost: (.info.cost // 0),
  messages: [
    .messages[]
    | select(.type == "user" or .type == "assistant"
             or .type == "system" or .type == "synthetic")
    | message
  ]
}
JQ
)

# jq program that renders the canonical shape as Markdown.
SHOW_JQ=$(cat <<'JQ'
def fmt_json: tojson | "```json\n" + . + "\n```";
def ts: if . == null then "" else (./1000 | gmtime | strftime("%Y-%m-%d %H:%M")) end;
def model_label:
  if type == "object" then
    (((.providerID // "") + (if (.providerID // "") != "" and ((.id // .modelID) // "") != "" then "/" else "" end) + ((.id // .modelID) // ""))
     + (if .variant then " (" + .variant + ")" else "" end))
  elif type == "string" then .
  else "" end;

def render_part:
  if .type == "text" then (.text // "")
  elif .type == "reasoning" then
    (if (.text // "") == "" then ""
     else "\n<details><summary>💭 Reasoning</summary>\n\n" + .text + "\n\n</details>\n" end)
  elif .type == "tool" then
    "\n### 🔧 Tool: `" + (.tool // "?") + "` (" + (.state.status // "?") + ")\n"
    + (if (.state.input // null) != null then "\n**Input:**\n" + (.state.input | fmt_json) else "" end)
    + (if (.state.output // null) != null then "\n\n**Output:**\n```\n" + (.state.output | tostring) + "\n```" else "" end)
    + (if (.state.error // null) != null then "\n\n**Error:** " + (.state.error | tostring) else "" end)
  elif .type == "file" then
    "\n📎 **Attachment**: `" + (.filename // "(unnamed)") + "` (" + (.mime // "") + ") " + (.url // "")
  elif .type == "compaction" then
    "\n---\n\n> 🗜️ **Compaction point** "
    + (if .auto then "(automatic)" else "(manual /compact)" end)
    + "\n>\n> _Messages before this point have been compacted into a summary. The full tail follows._\n\n---\n"
  else
    "\n<details><summary>⚠️ Unknown part type: `" + (.type // "null") + "`</summary>\n\n"
    + (tojson | "```json\n" + . + "\n```") + "\n\n</details>\n"
  end;

def header:
  (if .role == "user" then "## 🧑 User"
   elif .role == "assistant" then "## 🤖 Assistant"
   else "## ⚙️ System" end) as $h
  | ($h + (if (.model | model_label) != "" then "  ·  " + (.model | model_label) else "" end))
    + (if .time_created then "\n*" + (.time_created | ts) + "*" else "" end);

def footer:
  if .role == "assistant" and (.tokens // null) != null then
    "\n> _tokens: in=" + ((.tokens.input // 0) | tostring)
    + " out=" + ((.tokens.output // 0) | tostring)
    + " reasoning=" + ((.tokens.reasoning // 0) | tostring)
    + (if .cost != null then " · cost=$" + ((.cost * 10000 | round) / 10000 | tostring) else "" end)
    + (if .finish then " · finish=" + .finish else "" end) + "_"
  else "" end;

"# " + .title + "\n\n"
+ "- **Session ID**: `" + .session_id + "`\n"
+ (if .created_at then "- **Created**: " + (.created_at | ts) + "\n" else "" end)
+ (if .directory then "- **Directory**: `" + .directory + "`\n" else "" end)
+ (if .agent then "- **Agent**: " + .agent + "\n" else "" end)
+ (if (.model | model_label) != "" then "- **Model**: " + (.model | model_label) + "\n" else "" end)
+ "- **Tokens**: input=" + (.tokens.input | tostring)
+ ", output=" + (.tokens.output | tostring)
+ ", reasoning=" + (.tokens.reasoning | tostring) + "\n"
+ "- **Cost**: $" + (((.cost // 0) * 10000 | round) / 10000 | tostring) + "\n"
+ "\n---"
+ ([ .messages[]
    | "\n" + ("=" * 80) + "\n" + header + "\n"
      + ([.parts[] | render_part] | join("\n"))
      + footer
  ] | join("\n"))
+ "\n"
JQ
)

# Turn a v2 database session into an export-shaped document.
db_v2_export_like() {
    local sid="$1" esid; esid=$(sql_escape "$sid")
    tmp_dir; local d="$TMP_RESULT"

    sq <<SQL > "$d/session.json"
.mode json
SELECT id, title, time_created, directory, agent, model, cost,
       tokens_input, tokens_output, tokens_reasoning,
       tokens_cache_read, tokens_cache_write
FROM session_v2 WHERE id='${esid}';
SQL
    [[ -s "$d/session.json" ]] || printf '[]' > "$d/session.json"

    sq <<SQL > "$d/messages.json"
.mode json
SELECT id, type, seq, time_created, data
FROM session_message WHERE session_id='${esid}'
ORDER BY seq;
SQL
    [[ -s "$d/messages.json" ]] || printf '[]' > "$d/messages.json"

    jq -n --slurpfile s "$d/session.json" --slurpfile m "$d/messages.json" '
        ($s[0][0] // null) as $s
        | if $s == null then error("session not found") else
        {
          info: {
            id: $s.id,
            title: $s.title,
            agent: $s.agent,
            model: ($s.model | if type == "string" and startswith("{") then (fromjson? // .) else . end),
            cost: ($s.cost // 0),
            tokens: {
              input:     ($s.tokens_input // 0),
              output:    ($s.tokens_output // 0),
              reasoning: ($s.tokens_reasoning // 0),
              cache: {
                read:  ($s.tokens_cache_read // 0),
                write: ($s.tokens_cache_write // 0)
              }
            },
            time: {created: $s.time_created},
            location: {directory: $s.directory}
          },
          messages: [
            $m[0][]
            | (.data | fromjson) as $d
            | $d + {
                id: .id,
                type: .type,
                time: (($d.time // {}) + {created: (($d.time.created) // .time_created)})
              }
          ]
        } end
    '
}

# Turn a legacy (v1) database session into an export-shaped document.
db_v1_export_like() {
    local sid="$1" esid; esid=$(sql_escape "$sid")
    tmp_dir; local d="$TMP_RESULT"

    sq <<SQL > "$d/session.json"
.mode json
SELECT id, title, time_created, directory, agent, model, cost,
       tokens_input, tokens_output, tokens_reasoning
FROM session WHERE id='${esid}';
SQL
    [[ -s "$d/session.json" ]] || printf '[]' > "$d/session.json"

    sq <<SQL > "$d/messages.json"
.mode json
SELECT id, time_created, data
FROM message WHERE session_id='${esid}'
ORDER BY time_created, id;
SQL
    [[ -s "$d/messages.json" ]] || printf '[]' > "$d/messages.json"

    sq <<SQL > "$d/parts.json"
.mode json
SELECT id, message_id, time_created, data
FROM part WHERE session_id='${esid}'
ORDER BY time_created, id;
SQL
    [[ -s "$d/parts.json" ]] || printf '[]' > "$d/parts.json"

    jq -n --slurpfile s "$d/session.json" --slurpfile m "$d/messages.json" --slurpfile p "$d/parts.json" '
        ($s[0][0] // null) as $s
        | if $s == null then error("session not found") else
        ($p[0]
          | map(. + {parsed: (.data | fromjson)})
          | group_by(.message_id)
          | map({key: .[0].message_id, value: (map(.parsed))})
          | from_entries
        ) as $byMsg
        | {
          info: {
            id: $s.id,
            title: $s.title,
            agent: $s.agent,
            model: ($s.model | if type == "string" and startswith("{") then (fromjson? // .) else . end),
            cost: ($s.cost // 0),
            tokens: {
              input:     ($s.tokens_input // 0),
              output:    ($s.tokens_output // 0),
              reasoning: ($s.tokens_reasoning // 0),
              cache: {read: 0, write: 0}
            },
            time: {created: $s.time_created},
            location: {directory: $s.directory}
          },
          messages: [
            $m[0][]
            | (.data | fromjson) as $d
            | {
                id: .id,
                type: $d.role,
                time: {created: .time_created},
                model: ($d.model // (
                  if ($d.providerID // $d.modelID) then
                    {providerID: $d.providerID, id: $d.modelID}
                  else null end)),
                tokens: ($d.tokens // null),
                cost: ($d.cost // null),
                finish: ($d.finish // null),
                content: ($byMsg[.id] // [])
              }
          ]
        } end
    '
}

# Print the canonical JSON for a session.
canonical_json() {
    local sid="$1"
    tmp_dir; local d="$TMP_RESULT"

    if have_cli; then
        if opencode session export "$sid" > "$d/export.json" 2>"$d/export.err" \
           && [[ -s "$d/export.json" ]] \
           && jq -e '.info and (.messages | type == "array")' "$d/export.json" >/dev/null 2>&1; then
            jq "$CANON_JQ" "$d/export.json" && return 0
        fi
        if [[ "$EXPORT_SOURCE" == "cli" ]]; then
            [[ -s "$d/export.err" ]] && cat "$d/export.err" >&2
            die "opencode session export failed for: $sid"
        fi
    fi

    need_db
    local schema table esid exists
    schema=$(db_schema)
    case "$schema" in
        v2) table=session_v2 ;;
        v1) table=session ;;
        *)  die "unrecognised OpenCode database schema in: $DB" ;;
    esac
    esid=$(sql_escape "$sid")
    exists=$(sq "SELECT COUNT(*) FROM $table WHERE id='${esid}';")
    [[ "$exists" -gt 0 ]] || die "session not found: $sid"

    case "$schema" in
        v2) db_v2_export_like "$sid" | jq "$CANON_JQ" ;;
        v1) db_v1_export_like "$sid" | jq "$CANON_JQ" ;;
    esac
}

# ---------- list ----------
cmd_list() {
    need_db
    local limit=20 search=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -s|--search) search="${2:-}"; shift 2 ;;
            -n|--limit)  limit="${2:-}";  shift 2 ;;
            *)           die "unknown option to list: $1" ;;
        esac
    done
    is_uint "$limit" || die "-n expects a number"

    local table
    case "$(db_schema)" in
        v2) table=session_v2 ;;
        v1) table=session ;;
        *)  die "unrecognised OpenCode database schema in: $DB" ;;
    esac

    local where=""
    if [[ -n "$search" ]]; then
        where="WHERE title LIKE '%$(sql_escape "$search")%'"
    fi
    sq <<SQL
.mode column
.headers off
SELECT
    id,
    datetime(time_created/1000, 'unixepoch', 'localtime'),
    title
FROM ${table}
${where}
ORDER BY time_created DESC
LIMIT ${limit};
SQL
}

# ---------- show (markdown to stdout) ----------
cmd_show() {
    local sid="${1:-}"
    [[ -n "$sid" ]] || die "usage: show <session_id>"
    need_session_source
    canonical_json "$sid" | jq -r "$SHOW_JQ"
}

# ---------- html (same renderer/template as the web GUI) ----------
cmd_html() {
    local sid="" output="" target="/dev/stdout"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -o|--output) [[ $# -ge 2 && -n "$2" ]] || die "-o expects a file path"; output="$2"; shift 2 ;;
            -*) die "unknown option to html: $1" ;;
            *) [[ -z "$sid" ]] || die "unexpected argument: $1"; sid="$1"; shift ;;
        esac
    done
    [[ -n "$sid" ]] || die "usage: html <session_id> [-o <file>]"
    command -v php >/dev/null || die "php is required for HTML export"

    tmp_dir
    local d="$TMP_RESULT" script_dir renderer
    canonical_json "$sid" > "$d/session.json"

    # Use the same render_session() implementation and session.php template as
    # /s/<slug>. OPENCODE_EXPORT_ROOT supports split client/server installs.
    script_dir=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
    renderer="${OPENCODE_EXPORT_ROOT:-$script_dir}/server/app/render-cli.php"
    [[ -f "$renderer" ]] || die "web renderer not found: $renderer (set OPENCODE_EXPORT_ROOT to the project root)"

    [[ -z "$output" ]] || { mkdir -p "$(dirname "$output")"; target="$output"; }
    php "$renderer" "$d/session.json" > "$target"

    [[ -z "$output" ]] || echo "✓ exported web-view HTML: $output" >&2
}

# Collect a share password into $2 according to mode $1 (prompt|stdin|clear).
# An empty file means "remove the password".
read_password() {
    local mode="$1" out="$2" pw1 pw2
    case "$mode" in
        prompt)
            { exec 3< /dev/tty; } 2>/dev/null || die "-p needs an interactive terminal (use --password-stdin for scripts)"
            read -r -s -u 3 -p "Password for this share: " pw1; echo >&2
            read -r -s -u 3 -p "Confirm password: "        pw2; echo >&2
            exec 3<&-
            [[ "$pw1" == "$pw2" ]] || die "passwords do not match"
            [[ ${#pw1} -ge 4 ]]    || die "password must be at least 4 characters"
            printf '%s' "$pw1" > "$out"
            ;;
        stdin)
            IFS= read -r pw1 || true
            [[ -n "$pw1" ]] || die "no password read from stdin"
            printf '%s' "$pw1" > "$out"
            ;;
        clear)
            printf '' > "$out"
            ;;
    esac
}

# Turn a share URL (any form: /s/x, /s/x/raw, ?page=) or bare slug into a slug.
slug_from_arg() {
    local slug="$1"
    if [[ "$slug" == http* ]]; then
        slug="${slug%%\?*}"
        slug="${slug%/}"
        slug="${slug%/raw}"
        slug="${slug##*/}"
    fi
    [[ "$slug" =~ ^[A-Za-z0-9_-]+$ ]] || die "invalid slug format: $slug"
    printf '%s' "$slug"
}

# ---------- upload (JSON payload, server renders HTML) ----------
build_payload() {
    local sid="$1"
    need_session_source
    canonical_json "$sid"
}

cmd_upload() {
    local sid="" pw_mode="keep"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--password)    pw_mode="prompt"; shift ;;
            --password-stdin) pw_mode="stdin";  shift ;;
            --clear-password) pw_mode="clear";  shift ;;
            -*)               die "unknown option to upload: $1" ;;
            *)                [[ -z "$sid" ]] || die "unexpected argument: $1"; sid="$1"; shift ;;
        esac
    done
    [[ -n "$sid" ]] || die "usage: upload <session_id> [-p | --password-stdin | --clear-password]"
    need_server

    tmp_dir; local tmpdir="$TMP_RESULT"
    local body_file="$tmpdir/payload.json"
    local resp_file="$tmpdir/response.json"
    local pw_file="$tmpdir/password"

    build_payload "$sid" > "$body_file"

    # Password handling. The password is passed to jq via a file inside the
    # private temp dir (never as an argument), and stripped by the server before
    # the payload is stored.
    [[ "$pw_mode" == "keep" ]] || read_password "$pw_mode" "$pw_file"
    if [[ "$pw_mode" != "keep" ]]; then
        jq --rawfile pw "$pw_file" '. + {password: (if $pw == "" then null else $pw end)}' \
            "$body_file" > "$body_file.tmp" && mv "$body_file.tmp" "$body_file"
        rm -f "$pw_file"
    fi

    local http_code
    http_code=$(api_call "$resp_file" -X POST \
        -H "Content-Type: application/json" \
        --data-binary "@$body_file" \
        "${SHARE_URL%/}/api/upload") || die "upload failed (curl error)"

    if [[ "$http_code" != "200" && "$http_code" != "201" ]]; then
        echo "server returned HTTP $http_code:" >&2
        cat "$resp_file" >&2; echo >&2
        die "upload failed"
    fi

    local url short_url protected
    url=$(jq -r '.url // empty' < "$resp_file")
    short_url=$(jq -r '.short_url // empty' < "$resp_file")
    protected=$(jq -r '.protected // false' < "$resp_file")
    [[ -n "$url" ]] || { cat "$resp_file" >&2; die "unexpected response (no url)"; }

    # stderr: human-friendly summary
    echo "✓ uploaded" >&2
    echo "  full:  $url" >&2
    if [[ -n "$short_url" ]]; then
        echo "  short: $short_url  (expires in 7 days)" >&2
    fi
    if [[ "$protected" == "true" ]]; then
        echo "  🔒 password protected — raw JSON: curl -u :PASSWORD $url/raw" >&2
    fi

    # stdout: short URL if present (more useful to copy), else full URL
    if [[ -n "$short_url" ]]; then
        echo "$short_url"
    else
        echo "$url"
    fi
}

# ---------- shares (list server-side shared sessions) ----------
cmd_shares() {
    need_server

    local limit=0 search=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -s|--search) search="${2:-}"; shift 2 ;;
            -n|--limit)  limit="${2:-}";  shift 2 ;;
            *) die "unknown option to shares: $1" ;;
        esac
    done
    is_uint "$limit" || die "-n expects a number"

    tmp_file; local resp_file="$TMP_RESULT"

    local http_code
    http_code=$(api_call "$resp_file" "${SHARE_URL%/}/api/sessions") || die "request failed (curl error)"

    if [[ "$http_code" != "200" ]]; then
        echo "server returned HTTP $http_code:" >&2
        cat "$resp_file" >&2; echo >&2
        die "shares failed"
    fi

    local jq_filter
    if [[ -n "$search" ]]; then
        jq_filter='[ .[] | select(.title | ascii_downcase | contains($s | ascii_downcase)) ] |
            .[] | [ (.updated_at | strftime("%Y-%m-%d %H:%M")), .slug, .url, (.short_url // ""), (if .protected then "🔒" else "" end), .title ] | join("\u001f")'
    else
        jq_filter='.[] | [ (.updated_at | strftime("%Y-%m-%d %H:%M")), .slug, .url, (.short_url // ""), (if .protected then "🔒" else "" end), .title ] | join("\u001f")'
    fi

    local result
    result=$(jq -r --arg s "$search" "$jq_filter" < "$resp_file")

    if [[ -z "$result" ]]; then
        echo "(no shared sessions)"
        return
    fi

    if [[ "$limit" -gt 0 ]]; then
        result=$(echo "$result" | head -n "$limit")
    fi

    # Fields are separated by the ASCII unit separator: unlike tabs it is not
    # IFS whitespace, so empty fields (no short URL, no lock) are preserved.
    while IFS=$'\x1f' read -r updated slug url short_url lock title; do
        printf "%s  %s  %s%s\n" "$updated" "$slug" "${lock:+$lock }" "$title"
        printf "    %s\n" "$url"
        if [[ -n "$short_url" ]]; then
            printf "    %s\n" "$short_url"
        fi
    done <<< "$result"
}

# ---------- purge (delete all shared sessions) ----------
cmd_purge() {
    need_server

    # Count first
    tmp_file; local resp_file="$TMP_RESULT"

    local http_code
    http_code=$(api_call "$resp_file" "${SHARE_URL%/}/api/sessions") || die "request failed (curl error)"

    [[ "$http_code" == "200" ]] || { cat "$resp_file" >&2; die "purge failed (HTTP $http_code)"; }

    local count
    count=$(jq 'length' < "$resp_file")

    if [[ "$count" -eq 0 ]]; then
        echo "Nothing to delete."
        return
    fi

    printf "About to delete %d shared session(s). Type YES to confirm: " "$count"
    local confirm; read -r confirm
    [[ "$confirm" == "YES" ]] || { echo "Aborted."; exit 0; }

    http_code=$(api_call "$resp_file" -X DELETE "${SHARE_URL%/}/api/sessions") || die "purge failed (curl error)"

    case "$http_code" in
        200) echo "✓ deleted $(jq '.deleted' < "$resp_file") session(s)" ;;
        204) echo "✓ all sessions deleted" ;;
        *)   cat "$resp_file" >&2; die "purge failed (HTTP $http_code)" ;;
    esac
}

# ---------- password (set / change / remove on an existing share) ----------
cmd_password() {
    local slug="" pw_mode="prompt"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--password)    pw_mode="prompt"; shift ;;
            --password-stdin) pw_mode="stdin";  shift ;;
            --clear)          pw_mode="clear";  shift ;;
            -*)               die "unknown option to password: $1" ;;
            *)                [[ -z "$slug" ]] || die "unexpected argument: $1"; slug="$1"; shift ;;
        esac
    done
    [[ -n "$slug" ]] || die "usage: password <slug|url> [-p | --password-stdin | --clear]"
    need_server
    slug=$(slug_from_arg "$slug")

    tmp_dir; local tmpdir="$TMP_RESULT"
    read_password "$pw_mode" "$tmpdir/password"
    jq -n --rawfile pw "$tmpdir/password" '{password: (if $pw == "" then null else $pw end)}' > "$tmpdir/body.json"
    rm -f "$tmpdir/password"

    local http_code
    http_code=$(api_call "$tmpdir/resp.json" -X PUT \
        -H "Content-Type: application/json" \
        --data-binary "@$tmpdir/body.json" \
        "${SHARE_URL%/}/api/share/$slug/password") || die "request failed (curl error)"

    case "$http_code" in
        200)
            if [[ "$(jq -r '.protected' < "$tmpdir/resp.json")" == "true" ]]; then
                echo "✓ password set: ${SHARE_URL%/}/s/$slug  (raw JSON: curl -u :PASSWORD .../raw)"
            else
                echo "✓ password removed: ${SHARE_URL%/}/s/$slug is public again"
            fi ;;
        404) die "not found: $slug" ;;
        *)   cat "$tmpdir/resp.json" >&2; echo >&2; die "failed (HTTP $http_code)" ;;
    esac
}

# ---------- delete ----------
cmd_delete() {
    local slug="${1:-}"
    [[ -n "$slug" ]] || die "usage: delete <slug|url>"
    need_server

    slug=$(slug_from_arg "$slug")

    local http_code
    http_code=$(api_call /dev/null -X DELETE "${SHARE_URL%/}/api/share/$slug") || die "delete failed (curl error)"

    case "$http_code" in
        204|200) echo "✓ deleted: $slug" ;;
        404)     die "not found: $slug" ;;
        *)       die "delete failed (HTTP $http_code)" ;;
    esac
}

# ---------- Dispatch ----------
if [[ $# -eq 0 ]]; then
    cmd_list
    exit 0
fi

sub="$1"; shift
case "$sub" in
    list)             cmd_list "$@" ;;
    show)             cmd_show "$@" ;;
    html)             cmd_html "$@" ;;
    upload)           cmd_upload "$@" ;;
    shares)           cmd_shares "$@" ;;
    purge)            cmd_purge  "$@" ;;
    delete|rm)        cmd_delete "$@" ;;
    password|pw)      cmd_password "$@" ;;
    ses_*)            cmd_show "$sub" ;;
    *)                die "unknown subcommand: $sub (try -h)" ;;
esac
